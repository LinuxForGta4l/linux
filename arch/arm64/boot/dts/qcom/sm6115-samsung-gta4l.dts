/dts-v1/;

#include "sm6115.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Bengal SoC";
	compatible = "qcom,sm6115";
	qcom,msm-id = <0x1a1 0x10000 0x1bc 0x10000>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;

	aliases {
	};

	chosen {
		bootargs = "earlycon=tty0 console=tty0 clk_ignore_unused pd_ignore_unused";

		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "framebuffer0";

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x5c000000 0x0 (2000 * 1200 * 4)>;
			width = <1200>;
			height = <2000>;
			stride = <(1200 * 4)>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	reserved-memory {
		splash_memory:splash_region {
			reg = <0x0 0x5c000000 0x0 (2000 * 1200 * 4)>;
			no-map;
			label = "cont_splash_region";
		};
		
		mtp_mem: memory@cc300000 {
			reg = <0x00 0xcc300000 0x00 0xb00000>;
			no-map;
		};

		param_mem: memory@cc200000 {
			reg = <0x00 0xcc200000 0x00 0x100000>;
			no-map;
		};

		bootloader_log_mem: memory@5fff7000 {
			reg = <0x00 0x5fff7000 0x00 0x8000>;
			no-map;
		};

		ramoops@71300000 {
			compatible = "removed-dma-pool", "ramoops";
			no-map;
			reg = <0x00 0x71300000 0x00 0x100000>;
			record-size = <0x40000>;
			pmsg-size = <0x40000>;
			console-size = <0x40000>;
			ftrace-size = <0x40000>;
		};
	};

/* Idk why but bootloader wants this */
	__symbols__ {
		CPU0 = "/cpus/cpu@0";
		L2_0 = "/cpus/cpu@0/l2-cache";
		L1_I_0 = "/cpus/cpu@0/l1-icache";
		L1_D_0 = "/cpus/cpu@0/l1-dcache";
		CPU1 = "/cpus/cpu@1";
		L1_I_1 = "/cpus/cpu@1/l1-icache";
		L1_D_1 = "/cpus/cpu@1/l1-dcache";
