/* ===== M2 display scaffolding (inert until status flips + panel driver entry) ===== */
&tlmm {
	mdss_dsi_n: mdss-dsi-n-state {
		pins = "gpio81";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};
};

&mdss {
	status = "disabled"; /* M2: flip to "okay" */
};

&mdss_dsi0 {
	vdda-supply = <&pm6125_l18>;
	status = "disabled"; /* M2: flip to "okay" */

	/* TODO(variant): confirm panel via `adb shell dmesg | grep -i panel` on LOS,
	 * then set compatible to the matching samsung,gta4l-nt36523-<supplier> entry
	 * added to panel-novatek-nt36523.c (suppliers: hlt-auo / lce-panda / lide-hsd / txd-inx) */
	panel: panel@0 {
		compatible = "samsung,gta4l-nt36523-lide-hsd", "novatek,nt36523w";
		reg = <0>;

		reset-gpios = <&tlmm 81 GPIO_ACTIVE_LOW>;
		vddio-supply = <&pm6125_l9>;

		pinctrl-names = "default";
		pinctrl-0 = <&mdss_dsi_n>;

		rotation = <180>; /* downstream qcom,mdss-dsi-panel-orientation = "180" */

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	status = "disabled"; /* M2: flip to "okay" */
};

&sdhc_1 {
	status = "okay";
};

&sdhc_2 {
	status = "okay";
};

&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		pm6125_l9: l9 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l18: l18 {
			regulator-min-microvolt = <1104000>;
			regulator-max-microvolt = <1312000>;
		};
	};
};
